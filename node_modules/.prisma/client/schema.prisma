generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  PAUSED
  DISABLED
  TRIAL
}

enum SubscriptionStatus {
  DRAFT
  TRIAL
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ContactType {
  PHONE
  TELEGRAM
  WHATSAPP
  EMAIL
  OTHER
}

enum ClientType {
  INDIVIDUAL
  LEGAL_ENTITY
}

enum BikeStatus {
  AVAILABLE
  RESERVED
  RENTED
  BUYOUT
  RETURN_PENDING
  REPAIR
  WRITTEN_OFF
}

enum RentalStatus {
  NEW
  ACTIVE
  OVERDUE
  HOLD
  RETURN_PREP
  COMPLETED
  CANCELED
}

enum BuyoutStatus {
  NEW
  ACTIVE
  OVERDUE
  HOLD
  CLOSED
  TERMINATED
}

enum RentalTariffGroupKind {
  RENTAL
  BUYOUT
}

enum ScheduleOwnerType {
  RENTAL
  BUYOUT
}

enum ScheduleCadence {
  DAILY
  WEEKLY
  MONTHLY
}

enum ScheduleItemStatus {
  PLANNED
  PARTIAL
  PAID
  OVERDUE
  CANCELED
}

enum BankInstructionType {
  QR
  REQUISITES
}

enum TransactionType {
  RENTAL_PAYMENT_IN
  BUYOUT_PAYMENT_IN
  DOWN_PAYMENT_IN
  PARTIAL_PAYMENT_IN
  DEPOSIT_IN
  DEPOSIT_REFUND_OUT
  PENALTY_ACCRUAL
  PENALTY_PAYMENT_IN
  HOLD
  WRITE_OFF
  REFUND_OUT
  MANUAL_ADJUSTMENT
  SERVICE_EXPENSE
  REPAIR_EXPENSE
}

enum TransactionDirection {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  DRAFT
  POSTED
  CANCELED
}

enum TransactionCorrectionKind {
  NONE
  REVERSAL
}

enum PaymentMethod {
  BANK
  CASH
}

enum RepairStatus {
  OPEN
  COMPLETED
}

enum BikeKitType {
  BATTERY
  CHARGER
  HELMET
  CHAIN_LOCK
  KEY
  LOCK
  OTHER
}

enum EquipmentCatalogType {
  BATTERY
  CHARGER
  HELMET
  CHAIN_LOCK
  OTHER
}

enum DepositStatus {
  RECEIVED
  PARTIALLY_REFUNDED
  REFUNDED
  HELD
}

enum PenaltyMode {
  AUTO
  MANUAL
}

enum PenaltyStatus {
  DRAFT
  ACTIVE
  PAID
  WAIVED
}

enum DocumentTemplateKind {
  CONTRACT
  ISSUE_ACT
  RETURN_ACT
  BUYOUT_CONTRACT
  ADDENDUM
  CUSTOM
}

enum DocumentStatus {
  GENERATED
  SIGNED
  CANCELED
}

enum NotificationChannel {
  TELEGRAM
  WHATSAPP
  SMS
}

enum NotificationScenarioType {
  DEAL_CREATED
  PAYMENT_DUE
  PAYMENT_OVERDUE
  PAYMENT_RECEIVED
  DEPOSIT_RECEIVED
  DEPOSIT_REFUND
  MANUAL_BROADCAST
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum ImportStatus {
  DRAFT
  DRY_RUN
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum ImportRowDecision {
  CREATE
  MATCH_EXISTING
  SKIP
  FAIL
}

enum ImportIssueSeverity {
  INFO
  WARNING
  ERROR
}

enum ImportMatchQuality {
  RELIABLE
  HEURISTIC
}

enum ImportSource {
  MOYSKLAD
  LEGACY_CRM
}

enum IntegrationKind {
  MOYSKLAD
  TELEGRAM
  STARLINE
  YOOKASSA
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum GpsTrackerProvider {
  STARLINE
}

enum GpsSnapshotStatus {
  ONLINE
  OFFLINE
  UNKNOWN
  ERROR
}

enum GpsBindingSource {
  AUTO_MATCH
  MANUAL
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  TEXT
}

model Tenant {
  id                     String                  @id @default(uuid()) @db.Uuid
  slug                   String                  @unique
  name                   String
  status                 TenantStatus            @default(TRIAL)
  supportAccessEnabled   Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  subscriptions          TenantSubscription[]
  users                  User[]
  roles                  Role[]
  branches               Branch[]
  clients                Client[]
  clientWorkplaceOptions ClientWorkplaceOption[]
  clientRelatives        ClientRelative[]
  clientContacts         ClientContact[]
  clientIdentityData     ClientIdentityData[]
  bikeModels             BikeModel[]
  rentalTariffGroups     RentalTariffGroup[]
  rentalTariffGroupRates RentalTariffGroupRate[]
  bikeUnits              BikeUnit[]
  bikeKits               BikeKitItem[]
  gpsTrackers            GpsTracker[]
  equipmentCatalogItems  EquipmentCatalogItem[]
  dealEquipmentItems     DealEquipmentItem[]
  repairs                Repair[]
  repairLineItems        RepairLineItem[]
  rentals                Rental[]
  rentalTariffSnapshots  RentalTariffSnapshot[]
  buyouts                Buyout[]
  paymentSchedules       PaymentSchedule[]
  paymentScheduleItems   PaymentScheduleItem[]
  banks                  Bank[]
  bankAssets             BankAsset[]
  financeArticles        FinanceArticle[]
  transactions           FinancialTransaction[]
  deposits               Deposit[]
  depositRefunds         DepositRefund[]
  penalties              Penalty[]
  documentTemplates      DocumentTemplate[]
  documents              Document[]
  documentGenerations    DocumentGeneration[]
  notes                  Note[]
  notificationScenarios  NotificationScenario[]
  notifications          Notification[]
  imports                Import[]
  importJobs             ImportJob[]
  importJobRows          ImportJobRow[]
  integrations           Integration[]
  settings               Setting[]
  auditLogs              AuditLog[]
}

model SubscriptionPlan {
  id                   String               @id @default(uuid()) @db.Uuid
  code                 String               @unique
  name                 String
  monthlyPriceKopecks  Int
  maxUsers             Int?
  maxBranches          Int?
  maxBikeUnits         Int?
  maxDocumentsPerMonth Int?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  subscriptions        TenantSubscription[]
}

model TenantSubscription {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @db.Uuid
  planId    String             @db.Uuid
  status    SubscriptionStatus @default(DRAFT)
  startsAt  DateTime?
  endsAt    DateTime?
  autoRenew Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
}

model User {
  id                         String                 @id @default(uuid()) @db.Uuid
  tenantId                   String                 @db.Uuid
  branchId                   String?                @db.Uuid
  email                      String
  phone                      String?
  fullName                   String
  passwordHash               String
  status                     UserStatus             @default(INVITED)
  isTenantOwner              Boolean                @default(false)
  isSupportUser              Boolean                @default(false)
  lastLoginAt                DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  tenant                     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                     Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles                  UserRole[]
  createdRentals             Rental[]               @relation("RentalCreatedBy")
  createdBuyouts             Buyout[]               @relation("BuyoutCreatedBy")
  createdRepairs             Repair[]               @relation("RepairCreatedBy")
  createdTransactions        FinancialTransaction[] @relation("TransactionCreatedBy")
  reconciledTransactions     FinancialTransaction[] @relation("TransactionReconciledBy")
  createdDocuments           Document[]             @relation("DocumentCreatedBy")
  createdDocumentGenerations DocumentGeneration[]   @relation("DocumentGenerationCreatedBy")
  createdNotes               Note[]                 @relation("NoteCreatedBy")
  auditLogs                  AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  category    String
  name        String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  branchScoped Boolean    @default(false)
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Branch {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @db.Uuid
  name         String
  code         String
  address      String?
  phone        String?
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users        User[]
  clients      Client[]
  bikeUnits    BikeUnit[]
  rentals      Rental[]
  buyouts      Buyout[]
  repairs      Repair[]
  banks        Bank[]
  transactions FinancialTransaction[]

  @@unique([tenantId, code])
}

model Client {
  id                 String                 @id @default(uuid()) @db.Uuid
  tenantId           String                 @db.Uuid
  branchId           String?                @db.Uuid
  legacySource       ImportSource?
  legacyExternalId   String?
  legacyReference    String?
  fullName           String
  lastName           String?
  firstName          String?
  middleName         String?
  clientType         ClientType             @default(INDIVIDUAL)
  taxId              String?
  kpp                String?
  ogrn               String?
  primaryPhone       String?
  contactPersonName  String?
  telegramHandle     String?
  email              String?
  fax                String?
  maxHandle          String?
  courierId          String?
  isProblemClient    Boolean                @default(false)
  isThief            Boolean                @default(false)
  flagComment        String?
  address            String?
  legalTitle         String?
  gender             String?
  workplace          String?
  comment            String?
  currentDebtKopecks Int                    @default(0)
  overdueDebtKopecks Int                    @default(0)
  activeDealsCount   Int                    @default(0)
  paymentCount       Int                    @default(0)
  overdueCount       Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  contacts           ClientContact[]
  relatives          ClientRelative[]
  identityData       ClientIdentityData?
  rentals            Rental[]
  buyouts            Buyout[]
  deposits           Deposit[]
  depositRefunds     DepositRefund[]
  transactions       FinancialTransaction[]
  documents          Document[]
  notes              Note[]
  notifications      Notification[]
  currentBikeUnits   BikeUnit[]             @relation("CurrentBikeClient")

  @@unique([tenantId, legacySource, legacyExternalId])
  @@index([tenantId, fullName])
}

model ClientWorkplaceOption {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, label])
}

model ClientContact {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  clientId  String      @db.Uuid
  type      ContactType
  label     String?
  value     String
  isPrimary Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, type])
}

model ClientRelative {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  clientId  String   @db.Uuid
  fullName  String
  phone     String
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, fullName])
}

model ClientIdentityData {
  id                       String    @id @default(uuid()) @db.Uuid
  tenantId                 String    @db.Uuid
  clientId                 String    @unique @db.Uuid
  passportSeries           String?
  passportNumber           String?
  issuedBy                 String?
  issuedAt                 DateTime?
  departmentCode           String?
  birthDate                DateTime?
  registeredAddress        String?
  registeredAddressFull    String?
  registeredAddressComment String?
  registeredFiasCode       String?
  actualAddress            String?
  actualAddressFull        String?
  actualAddressComment     String?
  actualFiasCode           String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client                   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model BikeModel {
  id                  String     @id @default(uuid()) @db.Uuid
  tenantId            String     @db.Uuid
  name                String
  article             String?
  category            String?
  purchaseCostKopecks Int        @default(0)
  salePriceKopecks    Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bikeUnits           BikeUnit[]

  @@index([tenantId, name])
}

model RentalTariffGroup {
  id                      String                  @id @default(uuid()) @db.Uuid
  tenantId                String                  @db.Uuid
  kind                    RentalTariffGroupKind   @default(RENTAL)
  code                    String
  name                    String
  description             String?
  isActive                Boolean                 @default(true)
  depositTargetKopecks    Int                     @default(0)
  autoPenaltyEnabled      Boolean                 @default(true)
  manualPenaltyEnabled    Boolean                 @default(true)
  autoPenaltyDailyKopecks Int                     @default(0)
  graceDays               Int                     @default(0)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rates                   RentalTariffGroupRate[]
  rentalBikeUnits         BikeUnit[]              @relation("BikeRentalTariffGroup")
  buyoutBikeUnits         BikeUnit[]              @relation("BikeBuyoutTariffGroup")

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model RentalTariffGroupRate {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String            @db.Uuid
  rentalTariffGroupId String            @db.Uuid
  label               String
  durationDays        Int
  amountKopecks       Int
  bonusDays           Int               @default(0)
  sortOrder           Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentalTariffGroup   RentalTariffGroup @relation(fields: [rentalTariffGroupId], references: [id], onDelete: Cascade)

  @@unique([rentalTariffGroupId, durationDays])
  @@index([tenantId, durationDays])
}

model BikeUnit {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @db.Uuid
  branchId            String?            @db.Uuid
  bikeModelId         String?            @db.Uuid
  rentalTariffGroupId String?            @db.Uuid
  buyoutTariffGroupId String?            @db.Uuid
  legacySource        ImportSource?
  legacyExternalId    String?
  legacyReference     String?
  internalCode        String
  title               String
  article             String?
  serialNumber        String?
  odometerKm          Int                @default(0)
  status              BikeStatus         @default(AVAILABLE)
  currentClientId     String?            @db.Uuid
  purchaseCostKopecks Int                @default(0)
  salePriceKopecks    Int                @default(0)
  valuationKopecks    Int                @default(0)
  photoPath           String?
  conditionNote       String?
  comment             String?
  lastIssuedAt        DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch              Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  bikeModel           BikeModel?         @relation(fields: [bikeModelId], references: [id], onDelete: SetNull)
  rentalTariffGroup   RentalTariffGroup? @relation("BikeRentalTariffGroup", fields: [rentalTariffGroupId], references: [id], onDelete: SetNull)
  buyoutTariffGroup   RentalTariffGroup? @relation("BikeBuyoutTariffGroup", fields: [buyoutTariffGroupId], references: [id], onDelete: SetNull)
  currentClient       Client?            @relation("CurrentBikeClient", fields: [currentClientId], references: [id], onDelete: SetNull)
  repairs             Repair[]
  kits                BikeKitItem[]
  gpsTracker          GpsTracker?
  rentals             Rental[]
  buyouts             Buyout[]
  documents           Document[]

  @@unique([tenantId, internalCode])
  @@unique([tenantId, legacySource, legacyExternalId])
  @@index([tenantId, status, branchId])
  @@index([tenantId, rentalTariffGroupId])
  @@index([tenantId, buyoutTariffGroupId])
}

model BikeKitItem {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  bikeUnitId   String      @db.Uuid
  type         BikeKitType @default(OTHER)
  label        String
  serialNumber String?
  isPresent    Boolean     @default(true)
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bikeUnit     BikeUnit    @relation(fields: [bikeUnitId], references: [id], onDelete: Cascade)

  @@index([tenantId, bikeUnitId, type])
}

model EquipmentCatalogItem {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @db.Uuid
  type      EquipmentCatalogType @default(OTHER)
  label     String
  note      String?
  sortOrder Int                  @default(0)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dealItems DealEquipmentItem[]

  @@index([tenantId, isActive, sortOrder])
  @@index([tenantId, type, label])
}

model DealEquipmentItem {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @db.Uuid
  rentalId      String?               @db.Uuid
  buyoutId      String?               @db.Uuid
  catalogItemId String?               @db.Uuid
  type          EquipmentCatalogType  @default(OTHER)
  label         String
  quantity      Int                   @default(1)
  comment       String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rental        Rental?               @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  buyout        Buyout?               @relation(fields: [buyoutId], references: [id], onDelete: Cascade)
  catalogItem   EquipmentCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([tenantId, rentalId, createdAt])
  @@index([tenantId, buyoutId, createdAt])
  @@index([tenantId, type, createdAt])
}

model Repair {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  branchId     String?          @db.Uuid
  bikeUnitId   String           @db.Uuid
  createdById  String?          @db.Uuid
  serviceDate  DateTime
  status       RepairStatus     @default(OPEN)
  completedAt  DateTime?
  executorName String?
  sourceName   String?
  costKopecks  Int              @default(0)
  title        String
  description  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  bikeUnit     BikeUnit         @relation(fields: [bikeUnitId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation("RepairCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items        RepairLineItem[]

  @@index([tenantId, status, serviceDate])
  @@index([tenantId, bikeUnitId, serviceDate])
}

model RepairLineItem {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @db.Uuid
  repairId      String                @db.Uuid
  bankId        String?               @db.Uuid
  transactionId String?               @unique @db.Uuid
  title         String
  quantity      Int                   @default(1)
  amountKopecks Int                   @default(0)
  comment       String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  repair        Repair                @relation(fields: [repairId], references: [id], onDelete: Cascade)
  bank          Bank?                 @relation(fields: [bankId], references: [id], onDelete: SetNull)
  transaction   FinancialTransaction? @relation("RepairLineItemTransaction", fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([tenantId, repairId, createdAt])
}

model Rental {
  id                      String                 @id @default(uuid()) @db.Uuid
  tenantId                String                 @db.Uuid
  branchId                String?                @db.Uuid
  clientId                String                 @db.Uuid
  bikeUnitId              String                 @db.Uuid
  createdById             String?                @db.Uuid
  legacySource            ImportSource?
  legacyExternalId        String?
  legacyReference         String?
  dealNumber              String
  status                  RentalStatus           @default(NEW)
  isProblem               Boolean                @default(false)
  tariffCode              String
  tariffLabel             String
  startsAt                DateTime
  nextPaymentAt           DateTime?
  plannedPaymentKopecks   Int
  debtKopecks             Int                    @default(0)
  overdueDays             Int                    @default(0)
  depositTargetKopecks    Int                    @default(0)
  depositCollectedKopecks Int                    @default(0)
  depositReturnedKopecks  Int                    @default(0)
  autoPenaltyEnabled      Boolean                @default(true)
  manualPenaltyEnabled    Boolean                @default(true)
  autoPenaltyDailyKopecks Int                    @default(0)
  graceDays               Int                    @default(0)
  bankId                  String?                @db.Uuid
  comment                 String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                  Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  client                  Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  bikeUnit                BikeUnit               @relation(fields: [bikeUnitId], references: [id], onDelete: Restrict)
  createdBy               User?                  @relation("RentalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  bank                    Bank?                  @relation(fields: [bankId], references: [id], onDelete: SetNull)
  tariffSnapshots         RentalTariffSnapshot[]
  paymentSchedules        PaymentSchedule[]
  deposits                Deposit[]
  depositRefunds          DepositRefund[]
  penalties               Penalty[]
  equipmentItems          DealEquipmentItem[]
  transactions            FinancialTransaction[]
